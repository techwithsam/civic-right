rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read own, write own on create/update
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Reports: any authenticated citizen can read + create; only gov can update status
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reportedBy == request.auth.uid;
      allow update: if request.auth != null && (
        // Government users can update status
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'government'
        // Or only updating confirmationCount (citizen confirmation)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmationCount', 'status', 'updatedAt']))
      );
    }

    // Confirmations: users can only create their own, read own
    match /confirmations/{confirmId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // Authorities: read by all authenticated
    match /authorities/{authorityId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed via admin/seed script only
    }

    // Sources: read by all authenticated
    match /sources/{sourceId} {
      allow read: if request.auth != null;
      allow write: if false; // Managed via ingest API only
    }
  }
}
